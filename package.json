{
  "name": "devfest-manager",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "server": "json-server --watch db.json --port 3000 --delay 2000",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:devfest-manager": "node dist/devfest-manager/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "^22.1.6",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "express": "^5.1.0",
    "json-server": "^0.17.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
